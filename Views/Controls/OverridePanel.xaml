<UserControl x:Class="WpfPlotMvp.Views.Controls.OverridePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:WpfPlotMvp.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="320"
             d:DataContext="{d:DesignInstance vm:OverridePanelViewModel, IsDesignTimeCreatable=True}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Override Panel" FontSize="14" FontWeight="Bold"
                   Foreground="#ccd" Margin="0,0,0,8"/>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="8,3"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </TabControl.Resources>

            <!-- Tab 0: Structured Params -->
            <TabItem Header="Params">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header row -->
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tenor" Foreground="#8899aa" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Text="Current" Foreground="#8899aa" FontSize="11" FontWeight="Bold" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="Override" Foreground="#8899aa" FontSize="11" FontWeight="Bold" TextAlignment="Right"/>
                    </Grid>

                    <!-- Tenor rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Tenors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TenorOverrideItem}">
                                    <Border BorderBrush="#1a1a3e" BorderThickness="0,0,0,1" Padding="2,3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Foreground="#aaa" FontSize="12" VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="1" Text="{Binding CurrentRate, StringFormat={}{0:F4}}"
                                                       Foreground="#5588cc" FontSize="12"
                                                       TextAlignment="Right" VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>

                                            <TextBox Grid.Column="2" Text="{Binding OverrideRate, TargetNullValue=''}"
                                                     FontSize="12" Background="#0a0a2e" Foreground="#ffaa33"
                                                     TextAlignment="Right" BorderBrush="#333"
                                                     MinWidth="60" MaxWidth="100"
                                                     HorizontalAlignment="Right"
                                                     VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Tab 1: XML Editor -->
            <TabItem Header="XML">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Paste XML snippet to override curve parameters."
                               Foreground="#667" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <TextBox Grid.Row="1" Text="{Binding XmlText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas" FontSize="12"
                             Background="#0a0a2e" Foreground="#ccd"
                             BorderBrush="#333" BorderThickness="1"
                             Padding="6" SpellCheck.IsEnabled="False"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Stretch">
            <Button Content="Apply Override" Command="{Binding ApplyOverrideCommand}"
                    Background="#28a745" Foreground="White" Padding="8,6" FontSize="12"
                    BorderThickness="0" Cursor="Hand" HorizontalAlignment="Stretch" MinWidth="100">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverrideActive}" Value="True">
                                <Setter Property="Content" Value="Update"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Clear" Command="{Binding ClearOverrideCommand}"
                    Background="#6c757d" Foreground="White" Padding="8,6" FontSize="12"
                    BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" MinWidth="80"
                    IsEnabled="{Binding IsOverrideActive}"/>
        </StackPanel>

        <!-- Status indicator -->
        <Border Grid.Row="2" Background="#1a2e1a" CornerRadius="4" Padding="6,3"
                Margin="0,40,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOverrideActive}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="Override Active" Foreground="#8c8" FontSize="11"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
