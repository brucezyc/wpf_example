	"WPF OverridePanel Apply Payload Builder": {
		"prefix": "wpf-override-payload",
		"body": [
			"// Build override payload string for ApplyOverrideRequest",
			"var parts = new List<string>();",
			"foreach (var t in Tenors.Where(t => t.OverrideRate.HasValue))",
			"    parts.Add($\"{t.Label}={t.OverrideRate!.Value:F4}\");",
			"foreach (var label in _removedTenorLabels)",
			"    parts.Add(label);",
			"var payload = string.Join(\";\", parts);",
			"OverrideSubmitted?.Invoke(new ApplyOverrideRequest",
			"{",
			"    OverrideType = \"ParamOverride\",",
			"    Payload = payload",
			"});"
		],
		"description": "Build override payload string from TenorOverrideItems"
	},

