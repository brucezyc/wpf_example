	"WPF ViewModel (CommunityToolkit.Mvvm)": {
		"prefix": "wpf-vm",
		"body": [
			"using System;",
			"using System.Threading.Tasks;",
			"using System.Windows;",
			"using CommunityToolkit.Mvvm.ComponentModel;",
			"using CommunityToolkit.Mvvm.Input;",
			"using WpfPlotMvp.Protocols;",
			"using WpfPlotMvp.Workers;",
			"",
			"namespace WpfPlotMvp.ViewModels;",
			"",
			"public partial class ${1:NewPage}ViewModel : ObservableObject, IDisposable",
			"{",
			"    private readonly IWorkerClient _worker;",
			"",
			"    [ObservableProperty]",
			"    private string _statusText = \"Idle\";",
			"",
			"    [ObservableProperty]",
			"    private bool _isStreaming;",
			"",
			"    public ${1:NewPage}ViewModel()",
			"        : this(new InProcessMockWorker())",
			"    { }",
			"",
			"    public ${1:NewPage}ViewModel(IWorkerClient worker)",
			"    {",
			"        _worker = worker;",
			"        _worker.SnapshotReceived += OnSnapshotReceived;",
			"        _worker.StatusChanged += OnStatusChanged;",
			"        _worker.PriceTickReceived += OnPriceTick;",
			"    }",
			"",
			"    [RelayCommand]",
			"    private async Task StartStream()",
			"    {",
			"        if (IsStreaming) return;",
			"        IsStreaming = true;",
			"        try { await _worker.StartAsync(\"${2:SYMBOL}\", \"<config/>\", new CancellationTokenSource().Token); }",
			"        catch (Exception ex) { StatusText = $\"Error: {ex.Message}\"; IsStreaming = false; }",
			"    }",
			"",
			"    [RelayCommand]",
			"    private async Task StopStream()",
			"    {",
			"        if (!IsStreaming) return;",
			"        IsStreaming = false;",
			"        await _worker.StopAsync();",
			"        StatusText = \"Stopped\";",
			"    }",
			"",
			"    private void OnSnapshotReceived(object? sender, CurveSnapshot snapshot)",
			"    {",
			"        Application.Current.Dispatcher.Invoke(() => { RequestChartUpdate(); });",
			"    }",
			"",
			"    private void OnStatusChanged(object? sender, StatusMessage msg)",
			"    {",
			"        Application.Current.Dispatcher.Invoke(() => {",
			"            StatusText = !string.IsNullOrEmpty(msg.Detail) ? $\"{msg.Status}: {msg.Detail}\" : msg.Status.ToString();",
			"        });",
			"    }",
			"",
			"    private void OnPriceTick(object? sender, double price)",
			"    {",
			"        Application.Current.Dispatcher.Invoke(() => { ${3:/* update price display */} });",
			"    }",
			"",
			"    public Action<List<CurveSnapshot>, string, string>? UpdateChartAction { get; set; }",
			"    private bool _chartPending;",
			"    private void RequestChartUpdate()",
			"    {",
			"        if (_chartPending) return;",
			"        _chartPending = true;",
			"        Application.Current.Dispatcher.BeginInvoke(new Action(() => { _chartPending = false; UpdateChartAction?.Invoke(new(), \"\", \"\"); }));",
			"    }",
			"",
			"    public void Dispose() { _worker.Dispose(); }",
			"}"
		],
		"description": "New ViewModel with IWorkerClient + CommunityToolkit.Mvvm"
	},

	"WPF PricingPage XAML": {
		"prefix": "wpf-page-xaml",
		"body": [
			"<UserControl x:Class=\"WpfPlotMvp.Views.${1:PricingPage}\"",
			"             xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"",
			"             xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"",
			"             xmlns:ctrls=\"clr-namespace:WpfPlotMvp.Views.Controls\"",
			"             xmlns:vm=\"clr-namespace:WpfPlotMvp.ViewModels\"",
			"             d:DataContext=\"{d:DesignInstance vm:${2:PricingPage}ViewModel}\">",
			"    <Grid Margin=\"8\">",
			"        <Grid.RowDefinitions>",
			"            <RowDefinition Height=\"Auto\"/>",
			"            <RowDefinition Height=\"*\"/>",
			"            <RowDefinition Height=\"Auto\"/>",
			"        </Grid.RowDefinitions>",
			"",
			"        <!-- Header Bar -->",
			"        <Border Grid.Row=\"0\" Background=\"#1a1a2e\" CornerRadius=\"6\" Padding=\"10\" Margin=\"0,0,0,8\">",
			"            <Grid>",
			"                <Grid.ColumnDefinitions>",
			"                    <ColumnDefinition Width=\"Auto\"/>",
			"                    <ColumnDefinition Width=\"*\"/>",
			"                    <ColumnDefinition Width=\"Auto\"/>",
			"                </Grid.ColumnDefinitions>",
			"                <TextBlock Grid.Column=\"0\" Text=\"{Binding ${3:Symbol}}\" FontSize=\"20\" FontWeight=\"Bold\" Foreground=\"White\" VerticalAlignment=\"Center\" Margin=\"0,0,16,0\"/>",
			"                <Border Grid.Column=\"2\" Background=\"#16213e\" CornerRadius=\"4\" Padding=\"10,4\">",
			"                    <TextBlock Text=\"{Binding StatusText}\" Foreground=\"#8899aa\" FontSize=\"12\" VerticalAlignment=\"Center\"/>",
			"                </Border>",
			"            </Grid>",
			"        </Border>",
			"",
			"        <!-- Main Content -->",
			"        <Grid Grid.Row=\"1\">",
			"            <Grid.ColumnDefinitions>",
			"                <ColumnDefinition Width=\"*\"/>",
			"            </Grid.ColumnDefinitions>",
			"            <Border Grid.Column=\"0\" Background=\"#0f0f23\" CornerRadius=\"6\" Padding=\"6\">",
			"                <ctrls:InteractiveCurveChart x:Name=\"CurveChart\"/>",
			"            </Border>",
			"        </Grid>",
			"",
			"        <!-- Status Bar -->",
			"        <Border Grid.Row=\"2\" Background=\"#1a1a2e\" CornerRadius=\"4\" Padding=\"8,4\" Margin=\"0,8,0,0\">",
