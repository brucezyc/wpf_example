	"WPF ScottPlot 5 Chart Update": {
		"prefix": "wpf-chart-update",
		"body": [
			"var plot = PlotControl.Plot;",
			"plot.Clear();",
			"",
			"foreach (var snapshot in snapshots)",
			"{",
			"    double[] xs = snapshot.TenorYearFractions.ToArray();",
			"    var series = snapshot.Series.FirstOrDefault(s => s.Name == leftSeriesName);",
			"    if (series?.Values.Count == xs.Length)",
			"    {",
			"        double[] ys = series.Values.Select(v => (double)v).ToArray();",
			"        var scatter = plot.Add.Scatter(xs, ys);",
			"        scatter.Color = snapshot.Tag == \"original\"",
			"            ? new ScottPlot.Color(30, 144, 255)",
			"            : new ScottPlot.Color(255, 69, 0);",
			"        scatter.LineWidth = 2;",
			"        scatter.LegendText = $\"{leftSeriesName} ({snapshot.Tag})\";",
			"    }",
			"}",
			"PlotControl.Refresh();"
		],
		"description": "Update ScottPlot 5 chart with CurveSnapshot data"
	},

