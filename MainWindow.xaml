<Window x:Class="WpfPlotMvp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfPlotMvp"
        xmlns:vm="clr-namespace:WpfPlotMvp.ViewModels"
        xmlns:views="clr-namespace:WpfPlotMvp.Views"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="Quant Desktop" Height="700" Width="1200"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>
    <Grid>
        <TabControl x:Name="MainTabControl" Margin="4">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="12,6"/>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: Original Stream Plot MVP -->
            <TabItem Header="Stream MVP">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Start Stream" Command="{Binding StartStreamCommand}" Width="100" Margin="0,0,10,0"/>
                        <Button Content="Stop Stream" Command="{Binding StopStreamCommand}" Width="100" Margin="0,0,10,0"/>
                        <TextBlock Text="Current Value: " VerticalAlignment="Center" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentPrice}" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="Blue"/>
                    </StackPanel>

                    <ScottPlot:WpfPlot x:Name="WpfPlot1" Grid.Row="1" />
                </Grid>
            </TabItem>

            <!-- Tab 2: FX Curve Pricing Page -->
            <TabItem Header="FX Curve">
                <views:PricingPage/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
